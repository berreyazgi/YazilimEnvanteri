@using System.Text.Json
@model List<YazilimEnvanteri.Models.ViewModels.ProjeListItemViewModel>
@{
    ViewData["Title"] = "Projelerim";
    ViewData["Page"] = "projects";
    ViewData["NavKey"] = "projects";
    ViewData["ShowSearch"] = true;
    // UX only - ProjeController enforces CanManageProjects on Create/Edit itself.
    bool canManage = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.CanManageProjects)).Succeeded;
}

<section>
    <div class="section-header">
        <div>
            <h2 class="section-header-title">Projelerim</h2>
            <p class="section-header-subtitle">Tüm yazılım projeleri, sorumlu birimler, teknolojiler ve altyapı bilgilerine merkezi erişim.</p>
        </div>
        <div class="section-header-actions">
            <partial name="_ThemeToggle" />
            <a class="app-button app-button--outline" href="/Home/NasilKullanilir">
                <span data-icon="help" data-icon-size="16"></span> 
            </a>
            @if (canManage)
            {
                <button type="button" class="app-button" data-open-create-proje>
                    <span data-icon="projects" data-icon-size="16"></span> Yeni Proje
                </button>
            }
            <button type="button" class="app-button app-button--outline" data-export-excel title="Excel olarak dışa aktar">
                <span data-icon="externalLink" data-icon-size="16"></span> Excel
            </button>
            <button type="button" class="app-button app-button--outline" data-export-pdf title="PDF olarak dışa aktar">
                <span data-icon="externalLink" data-icon-size="16"></span> PDF
            </button>
        </div>
    </div>

    <button type="button" class="app-button app-button--outline filter-toolbar-toggle" data-filter-toolbar-toggle aria-expanded="false" aria-controls="proje-filter-toolbar">
        <span>
            <span data-icon="settings" data-icon-size="16"></span>
            Filtreler
        </span>
        <span data-icon="chevronDown" data-icon-size="16"></span>
    </button>

    <div class="app-card filter-toolbar" id="proje-filter-toolbar" data-filter-toolbar>
        <div class="filter-field filter-field--search">
            <label class="field-label" for="filter-search">Proje Ara</label>
            <input id="filter-search" type="search" class="field-input" data-project-search placeholder="Proje ara..." />
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-hizmet">Hizmet Alanı</label>
            <select id="filter-hizmet" class="field-select" data-project-filter="hizmetAlani" multiple></select>
        </div>
        <div class="filter-field filter-field--birim">
            <label class="field-label" for="filter-birim">Birim</label>
            <select id="filter-birim" class="field-select" data-project-filter="birim" multiple></select>
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-durum">Durum</label>
            <select id="filter-durum" class="field-select" data-project-filter="durum" multiple></select>
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-kritiklik">Kritiklik</label>
            <select id="filter-kritiklik" class="field-select" data-project-filter="kritiklik" multiple></select>
        </div>
        <div class="filter-field filter-actions">
            <label class="field-label filter-checkbox-label">
                <input type="checkbox" data-project-filter="sadeceAktif" /> Sadece Aktif Projeler
            </label>
            <label class="field-label filter-checkbox-label">
                <input type="checkbox" data-project-filter="sadeceWebAdresiOlan" /> Web Adresi Olanlar
            </label>
        </div>
    </div>

    <div class="filter-chips" data-filter-chips style="display:none;"></div>

    <div class="app-card">
        <div class="table-scroll" data-project-table-wrap>
            <table class="project-table">
                <thead data-project-table-head></thead>
                <tbody data-project-table-body></tbody>
            </table>
        </div>

        <div class="project-mobile-list" data-project-mobile-list></div>

        <div class="empty-state" data-project-empty-state style="display:none;">
            <span data-icon="inbox" data-icon-size="40"></span>
            <p class="empty-state-title">Henüz proje bulunmuyor.</p>
            <p class="empty-state-text">Filtrelerinizi değiştirebilir veya yeni proje verilerinin eklenmesini bekleyebilirsiniz.</p>
        </div>

        <div class="empty-state" data-project-error-state style="display:none;">
            <span data-icon="alertTriangle" data-icon-size="40"></span>
            <p class="empty-state-title">Veriler alınamadı.</p>
            <p class="empty-state-text">Proje verilerine şu anda erişilemiyor.</p>
            <button type="button" class="app-button" data-retry-load>Tekrar Dene</button>
        </div>

        <div class="pagination-bar" data-pagination-bar>
            <span class="pagination-summary" data-pagination-summary></span>
            <div class="pagination-size">
                <label for="page-size-select">Sayfa başına</label>
                <select id="page-size-select" data-page-size></select>
            </div>
            <div class="pagination-controls" data-pagination-controls></div>
        </div>
    </div>
</section>

@if (canManage)
{
    <partial name="_ProjeFormModal" />
}

@section Styles {
    <link rel="stylesheet" href="~/lib/choices.js/choices.min.css" />
    <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/choices.js/choices.min.js"></script>
    <script>
        window.__INITIAL_PROJECTS__ = @Html.Raw(JsonSerializer.Serialize(Model ?? new List<YazilimEnvanteri.Models.ViewModels.ProjeListItemViewModel>(), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
        window.__DATA_ERROR__ = @(((bool?)ViewBag.DataError ?? false) ? "true" : "false");
    </script>
}
