@using System.Text.Json
@model List<YazilimEnvanteri.Models.ViewModels.ProjeListItemViewModel>
@{
    ViewData["Title"] = "Projelerim";
    ViewData["Page"] = "projects";
    ViewData["NavKey"] = "projects";
    ViewData["ShowSearch"] = true;
    ViewData["TopbarTitle"] = "Projelerim";
}

<partial name="_Topbar" />

<section>
    <div class="section-header">
        <div>
            <h2 class="section-header-title">Projelerim</h2>
            <p class="section-header-subtitle">Tüm yazılım projeleri, sorumlu birimler, teknolojiler ve altyapı bilgilerine merkezi erişim.</p>
        </div>
        <div class="section-header-actions">
            <button type="button" class="app-button" data-open-create-proje>
                <span data-icon="projects" data-icon-size="16"></span> Yeni Proje
            </button>
            <button type="button" class="app-button app-button--outline" title="Excel olarak dışa aktar (bu sürümde yalnızca arayüz)">
                <span data-icon="externalLink" data-icon-size="16"></span> Excel
            </button>
            <button type="button" class="app-button app-button--outline" title="PDF olarak dışa aktar (bu sürümde yalnızca arayüz)">
                <span data-icon="externalLink" data-icon-size="16"></span> PDF
            </button>
        </div>
    </div>

    <button type="button" class="app-button app-button--outline filter-toolbar-toggle" data-filter-toolbar-toggle aria-expanded="false" aria-controls="proje-filter-toolbar">
        <span>
            <span data-icon="settings" data-icon-size="16"></span>
            Filtreler
        </span>
        <span data-icon="chevronDown" data-icon-size="16"></span>
    </button>

    <div class="app-card filter-toolbar" id="proje-filter-toolbar" data-filter-toolbar>
        <div class="filter-field">
            <label class="field-label" for="filter-search">Proje Ara</label>
            <input id="filter-search" type="search" class="field-input" data-project-search placeholder="Proje ara..." />
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-hizmet">Hizmet Alanı</label>
            <select id="filter-hizmet" class="field-select" data-project-filter="hizmetAlani"></select>
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-birim">Birim</label>
            <select id="filter-birim" class="field-select" data-project-filter="birim"></select>
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-durum">Durum</label>
            <select id="filter-durum" class="field-select" data-project-filter="durum"></select>
        </div>
        <div class="filter-field">
            <label class="field-label" for="filter-kritiklik">Kritiklik</label>
            <select id="filter-kritiklik" class="field-select" data-project-filter="kritiklik"></select>
        </div>
        <div class="filter-field">
            <button type="button" class="app-button app-button--outline" data-advanced-filter-toggle aria-expanded="false" aria-controls="advanced-filter-panel">
                <span data-icon="settings" data-icon-size="16"></span> Daha Fazla Filtre
            </button>
        </div>

        <div id="advanced-filter-panel" class="advanced-filter-panel" data-advanced-filter-panel>
            <label class="field-label filter-checkbox-label">
                <input type="checkbox" data-project-filter="sadeceAktif" /> Sadece Aktif Projeler
            </label>
            <label class="field-label filter-checkbox-label">
                <input type="checkbox" data-project-filter="sadeceWebAdresiOlan" /> Web Adresi Olanlar
            </label>
        </div>
    </div>

    <div class="filter-chips" data-filter-chips style="display:none;"></div>
    <button type="button" class="filter-chips-clear" data-clear-all-filters style="display:none; margin: -14px 0 18px;">Tümünü Temizle</button>

    <div class="app-card">
        <div class="table-scroll" data-project-table-wrap>
            <table class="project-table">
                <thead data-project-table-head></thead>
                <tbody data-project-table-body></tbody>
            </table>
        </div>

        <div class="project-mobile-list" data-project-mobile-list></div>

        <div class="empty-state" data-project-empty-state style="display:none;">
            <span data-icon="inbox" data-icon-size="40"></span>
            <p class="empty-state-title">Henüz proje bulunmuyor.</p>
            <p class="empty-state-text">Filtrelerinizi değiştirebilir veya yeni proje verilerinin eklenmesini bekleyebilirsiniz.</p>
        </div>

        <div class="empty-state" data-project-error-state style="display:none;">
            <span data-icon="alertTriangle" data-icon-size="40"></span>
            <p class="empty-state-title">Veriler alınamadı.</p>
            <p class="empty-state-text">Proje verilerine şu anda erişilemiyor.</p>
            <button type="button" class="app-button" data-retry-load>Tekrar Dene</button>
        </div>

        <div class="pagination-bar" data-pagination-bar>
            <span class="pagination-summary" data-pagination-summary></span>
            <div class="pagination-size">
                <label for="page-size-select">Sayfa başına</label>
                <select id="page-size-select" data-page-size></select>
            </div>
            <div class="pagination-controls" data-pagination-controls></div>
        </div>
    </div>
</section>

<div class="modal-overlay" data-create-proje-overlay>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-proje-title">
        <form data-create-proje-form novalidate>
            <div class="modal-header">
                <h2 class="modal-title" id="create-proje-title">Yeni Proje Oluştur</h2>
                <button type="button" class="modal-close" data-close-create-proje aria-label="Kapat">
                    <span data-icon="close" data-icon-size="18"></span>
                </button>
            </div>

            <!-- Mobile slider header / progress bar -->
            <div class="modal-slider-header" data-modal-slider-header>
                <div class="slider-progress-bar">
                    <div class="slider-progress-fill" data-slider-progress-fill style="width: 33.33%;"></div>
                </div>
                <div class="slider-step-info">
                    <span class="slider-step-title" data-slider-step-title>1. Temel Bilgiler</span>
                    <span class="slider-step-count" data-slider-step-count>1 / 3</span>
                </div>
                <div class="slider-dots" data-slider-dots>
                    <button type="button" class="slider-dot active" data-step-dot="1" aria-label="1. Adım"></button>
                    <button type="button" class="slider-dot" data-step-dot="2" aria-label="2. Adım"></button>
                    <button type="button" class="slider-dot" data-step-dot="3" aria-label="3. Adım"></button>
                </div>
            </div>

            <div class="modal-body" data-modal-body-slider>
                <div class="modal-error" data-create-proje-error></div>

                <div class="modal-slider-track" data-modal-slider-track data-active-step="1">
                    <!-- Slide 1: Temel Bilgiler -->
                    <div class="modal-slide active" data-slide="1">
                        <div class="slide-badge">1. Temel Bilgiler</div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-kodu">Proje Kodu</label>
                            <input id="create-proje-kodu" name="projeKodu" type="number" class="field-input" required />
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-adi">Proje Adı</label>
                            <input id="create-proje-adi" name="projeAdi" type="text" class="field-input" maxlength="200" required />
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-hizmet">Hizmet Alanı</label>
                            <input id="create-proje-hizmet" name="projeHizmetAlani" type="text" class="field-input" maxlength="100" placeholder="Örn. Yazılım, Altyapı, Uygulama" required />
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-durum">Durum</label>
                            <select id="create-proje-durum" name="projeDurum" class="field-select" required></select>
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-kritiklik">Kritiklik</label>
                            <select id="create-proje-kritiklik" name="projeKritiklik" class="field-select" required></select>
                        </div>
                    </div>

                    <!-- Slide 2: Sorumlu & Teknoloji -->
                    <div class="modal-slide" data-slide="2">
                        <div class="slide-badge">2. Sorumlu & Teknoloji</div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-birim">Birim</label>
                            <select id="create-proje-birim" name="birimId" class="field-select" required></select>
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-uzman">Yazılım Uzmanı</label>
                            <select id="create-proje-uzman" name="yazilimUzmaniId" class="field-select" required></select>
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-teknoloji">Teknoloji</label>
                            <select id="create-proje-teknoloji" name="teknolojiId" class="field-select" required></select>
                        </div>
                    </div>

                    <!-- Slide 3: Altyapı & Detaylar -->
                    <div class="modal-slide" data-slide="3">
                        <div class="slide-badge">3. Altyapı & Detaylar</div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-sunucu">Sunucu</label>
                            <input id="create-proje-sunucu" name="sunucu" type="text" class="field-input" maxlength="100" />
                        </div>

                        <div class="filter-field">
                            <label class="field-label" for="create-proje-website">Web Adresi</label>
                            <input id="create-proje-website" name="websiteUrl" type="text" class="field-input" maxlength="300" placeholder="https://..." />
                        </div>

                        <label class="modal-field-checkbox">
                            <input type="checkbox" name="projeAktifMi" checked /> Proje aktif
                        </label>

                        <div class="filter-field modal-field--full">
                            <label class="field-label" for="create-proje-aciklama">Proje Açıklaması</label>
                            <textarea id="create-proje-aciklama" name="projeAciklamasi" class="field-input" maxlength="500" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="app-button app-button--outline" data-close-create-proje data-modal-cancel-btn>Vazgeç</button>
                <button type="button" class="app-button app-button--outline" data-slider-prev-btn style="display:none;">
                    <span data-icon="chevronLeft" data-icon-size="16"></span> Geri
                </button>
                <button type="button" class="app-button" data-slider-next-btn style="display:none;">
                    İleri <span data-icon="chevronRight" data-icon-size="16"></span>
                </button>
                <button type="submit" class="app-button" data-create-proje-submit>Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.__INITIAL_PROJECTS__ = @Html.Raw(JsonSerializer.Serialize(Model ?? new List<YazilimEnvanteri.Models.ViewModels.ProjeListItemViewModel>(), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
        window.__DATA_ERROR__ = @(((bool?)ViewBag.DataError ?? false) ? "true" : "false");
    </script>
}
