@model YazilimEnvanteri.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ShowSearch"] = false;
    var success = TempData["Success"] as string;
}

<section>
    <div class="section-header">
        <div>
            <h2 class="section-header-title">Şifre Değiştir</h2>
            <p class="section-header-subtitle">Size verilen geçici şifreyi buradan kendi şifrenizle değiştirin.</p>
        </div>
        <div class="section-header-actions">
            <partial name="_ThemeToggle" />
        </div>
    </div>

    <div class="app-card auth-card">
        @if (success is not null)
        {
            <div class="form-alert form-alert--success" role="status">@success</div>
        }

        <form asp-action="ChangePassword" method="post" class="auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-alert form-alert--danger"></div>

            <div>
                <label asp-for="CurrentPassword" class="field-label"></label>
                <input asp-for="CurrentPassword" class="field-input" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="field-error"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="field-label"></label>
                <input asp-for="NewPassword" class="field-input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
                <span class="field-hint">En az 6 karakter; büyük harf, küçük harf, rakam ve sembol içermelidir.</span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="field-label"></label>
                <input asp-for="ConfirmPassword" class="field-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="app-button">Şifreyi Değiştir</button>
        </form>
    </div>
</section>
