@model YazilimEnvanteri.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Page"] = "home";
    ViewData["NavKey"] = "home";
    ViewData["ShowSearch"] = false;

    bool dataError = (bool?)ViewBag.DataError ?? false;
}

<partial name="_Topbar" />

<section class="app-card hero-banner">
    <div class="hero-banner-text">
        <h2 class="hero-banner-title">Tekrar hoş geldiniz!</h2>
        <p class="hero-banner-subtitle">Projeleri, ekipleri, teknolojileri ve altyapıyı tek bir yerden takip edin.</p>
    </div>
    <div class="hero-banner-art" aria-hidden="true">
        <svg width="140" height="100" viewBox="0 0 140 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="52" width="26" height="40" rx="4" fill="rgba(255,255,255,0.18)" />
            <rect x="42" y="30" width="26" height="62" rx="4" fill="rgba(255,255,255,0.28)" />
            <rect x="76" y="10" width="26" height="82" rx="4" fill="rgba(255,255,255,0.4)" />
            <rect x="110" y="40" width="22" height="52" rx="4" fill="rgba(255,255,255,0.22)" />
        </svg>
    </div>
</section>

@if (dataError)
{
    <div class="app-card empty-state" style="padding: 56px 24px;">
        <span data-icon="alertTriangle" data-icon-size="40"></span>
        <p class="empty-state-title">Veriler alınamadı.</p>
        <p class="empty-state-text">Gösterge paneli bilgilerine şu anda erişilemiyor. Lütfen daha sonra tekrar deneyin.</p>
        <a class="app-button" href="/">Tekrar Dene</a>
    </div>
}
else
{
    <div class="metric-grid">
        <div class="app-card metric-card">
            <div>
                <p class="metric-card-label">Toplam Proje</p>
                <p class="metric-card-value">@Model.ToplamProje</p>
            </div>
            <span class="metric-card-icon metric-card-icon--info" data-icon="projects" data-icon-size="20"></span>
        </div>
        <div class="app-card metric-card">
            <div>
                <p class="metric-card-label">Yayındaki Projeler</p>
                <p class="metric-card-value">@Model.YayindakiProje</p>
            </div>
            <span class="metric-card-icon metric-card-icon--success" data-icon="chart" data-icon-size="20"></span>
        </div>
        <div class="app-card metric-card">
            <div>
                <p class="metric-card-label">Geliştirme Aşamasında</p>
                <p class="metric-card-value">@Model.GelistirmedekiProje</p>
            </div>
            <span class="metric-card-icon metric-card-icon--purple" data-icon="layers" data-icon-size="20"></span>
        </div>
        <div class="app-card metric-card">
            <div>
                <p class="metric-card-label">Test / İnceleme</p>
                <p class="metric-card-value">@Model.TestIncelemeProje</p>
            </div>
            <span class="metric-card-icon metric-card-icon--warning" data-icon="alertTriangle" data-icon-size="20"></span>
        </div>
    </div>

    <section class="analytics-placeholder">
        <div class="section-header">
            <div>
                <h2 class="section-header-title">Detaylı Analizler</h2>
                <p class="section-header-subtitle">Bu bölümdeki grafikler yakında eklenecek.</p>
            </div>
        </div>
        <div class="analytics-placeholder-grid">
            <div class="app-card analytics-placeholder-card">
                <span class="analytics-placeholder-icon" data-icon="chart" data-icon-size="20"></span>
                <h3>Proje Durum Dağılımı</h3>
                <p>Grafik yakında eklenecek.</p>
            </div>
            <div class="app-card analytics-placeholder-card">
                <span class="analytics-placeholder-icon" data-icon="alertTriangle" data-icon-size="20"></span>
                <h3>Kritiklik Dağılımı</h3>
                <p>Grafik yakında eklenecek.</p>
            </div>
            <div class="app-card analytics-placeholder-card">
                <span class="analytics-placeholder-icon" data-icon="server" data-icon-size="20"></span>
                <h3>Birimlere Göre Projeler</h3>
                <p>Grafik yakında eklenecek.</p>
            </div>
            <div class="app-card analytics-placeholder-card">
                <span class="analytics-placeholder-icon" data-icon="layers" data-icon-size="20"></span>
                <h3>Teknoloji Dağılımı</h3>
                <p>Grafik yakında eklenecek.</p>
            </div>
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
