@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    ViewData["Page"] = "error";
    ViewData["NavKey"] = "";
    ViewData["ShowSearch"] = false;
    ViewData["TopbarTitle"] = "Bir Hata Oluştu";
}

<partial name="_Topbar" />

<div class="app-card empty-state" style="padding: 64px 24px;">
    <span data-icon="alertTriangle" data-icon-size="40"></span>
    <p class="empty-state-title">Beklenmeyen bir hata oluştu.</p>
    <p class="empty-state-text">İsteğiniz işlenirken bir sorunla karşılaşıldı. Lütfen tekrar deneyin.</p>
    @if (Model.ShowRequestId)
    {
        <p class="empty-state-text"><strong>İstek No:</strong> <code>@Model.RequestId</code></p>
    }
    <a class="app-button" href="/">Ana Sayfaya Dön</a>
</div>
