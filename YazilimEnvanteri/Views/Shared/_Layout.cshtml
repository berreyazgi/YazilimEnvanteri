<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project Inventory &amp; Management Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="masthead">
        <div class="masthead-left">
            <span class="masthead-logo">
                <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="4" width="12" height="12" rx="3" fill="#2F6FED" />
                    <rect x="18" y="4" width="12" height="12" rx="3" fill="#8FB3F7" />
                    <rect x="4" y="18" width="12" height="12" rx="3" fill="#8FB3F7" />
                    <rect x="18" y="18" width="12" height="12" rx="3" fill="#1B3F8F" />
                </svg>
            </span>
            <div>
                <h1 class="masthead-title">Project Inventory &amp; Management Portal</h1>
                <p class="masthead-subtitle">People &bull; Applications &bull; Infrastructure &bull; A More Connected Organization</p>
            </div>
        </div>
        <div class="masthead-right">
            <div class="masthead-block">
                <span>One Platform</span>
                <span>Complete Visibility</span>
                <span>Greater Impact</span>
            </div>
            <div class="masthead-divider"></div>
            <div class="masthead-block">
                <span>Track&nbsp;&nbsp;&nbsp;Manage&nbsp;&nbsp;&nbsp;Collaborate</span>
                <span class="masthead-accent">Build a Smarter Tomorrow</span>
            </div>
        </div>
    </header>

    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-logo">
                <svg width="26" height="26" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="4" y="4" width="12" height="12" rx="3" fill="#2F6FED" />
                    <rect x="18" y="4" width="12" height="12" rx="3" fill="#4C7FEA" />
                    <rect x="4" y="18" width="12" height="12" rx="3" fill="#4C7FEA" />
                    <rect x="18" y="18" width="12" height="12" rx="3" fill="#8FB3F7" />
                </svg>
            </div>
            <nav class="sidebar-nav">
                <a class="sidebar-link active" asp-controller="Home" asp-action="Index" data-nav="home">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /></svg>
                    Home
                </a>
                <a class="sidebar-link" href="#" data-nav="projects" data-nav-disabled="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                    Projects
                </a>
                <a class="sidebar-link" href="#" data-nav="infrastructure" data-nav-disabled="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><circle cx="7" cy="7" r="0.5" fill="currentColor" /><circle cx="7" cy="17" r="0.5" fill="currentColor" /></svg>
                    Infrastructure
                </a>
                <a class="sidebar-link" href="#" data-nav="reports" data-nav-disabled="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10" /><path d="M12 20V4" /><path d="M20 20v-7" /></svg>
                    Reports
                </a>
                <a class="sidebar-link" href="#" data-nav="users" data-nav-disabled="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3.2" /><path d="M2.5 20c1-3.5 3.6-5.5 6.5-5.5s5.5 2 6.5 5.5" /><circle cx="17.5" cy="9" r="2.3" /><path d="M15.8 14.2c2.4.4 4.2 2 5 5.3" /></svg>
                    Users
                </a>
                <a class="sidebar-link" href="#" data-nav="settings" data-nav-disabled="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.6 1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.6 1z" /></svg>
                    Settings
                </a>
            </nav>
            <div class="sidebar-tagline">
                <span>Better</span>
                <span>Applications</span>
                <span>Stronger</span>
                <span>Public Services</span>
            </div>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
