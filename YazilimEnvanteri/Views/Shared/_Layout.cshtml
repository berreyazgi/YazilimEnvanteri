<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yazılım Envanteri ve Yönetim Portalı</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-page="@(ViewData["Page"] ?? "")" data-nav-key="@(ViewData["NavKey"] ?? "")">
    <partial name="_MobileHeader" />

    <div class="app-shell">
        <partial name="_Sidebar" />

        <main class="content" id="main-content">
            @RenderBody()
        </main>
    </div>

    <div class="toast-container" data-toast-container aria-live="polite"></div>

    <script src="~/js/config/app-config.js" asp-append-version="true"></script>
    <script src="~/js/modules/toast.js" asp-append-version="true"></script>
    <script src="~/js/modules/sidebar.js" asp-append-version="true"></script>
    <script src="~/js/modules/dropdown.js" asp-append-version="true"></script>
    <script src="~/js/modules/filters.js" asp-append-version="true"></script>
    <script src="~/js/modules/pagination.js" asp-append-version="true"></script>
    <script src="~/js/modules/projects.js" asp-append-version="true"></script>
    <script src="~/js/modules/project-form.js" asp-append-version="true"></script>
    <script src="~/js/modules/project-detail.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
